{
  "name": "jest-invert",
  "version": "0.4.1",
  "description": "Determine the integrity of your Jest tests by inverting the received value before it reaches expect().",
  "author": "Denny S. Temple <dev@dentemple.com>",
  "license": "MIT",
  "homepage": "https://github.com/dentemple/jest-invert#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dentemple/jest-invert.git"
  },
  "bugs": {
    "url": "https://github.com/dentemple/jest-invert/issues"
  },
  "keywords": [
    "jest",
    "testing",
    "expect",
    "tdd",
    "typescript"
  ],
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf coverage dist *.tsbuildinfo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "npm pack --dry-run && node ./scripts/check-package.mjs",
    "prepack": "npm run build",
    "release": "changeset publish",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "verify": "npm run clean && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run package:check",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "jest": "^29.7.0 || ^30.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
